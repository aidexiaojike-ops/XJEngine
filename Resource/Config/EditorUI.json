{
  "layout": {
    "dockspace": true,
    "imguiIniPath": "Saved/Config/imgui.ini",
    "saveImguiIni": true
  },
  "panels": {
    "contentBrowser": {
      "currentPath": "Resource/Material",
      "filter": "",
      "rootPath": "Resource",
      "showAssetType": true,
      "showFolders": true,
      "showHandle": true,
      "title": "Content Browser",
      "visible": true
    },
    "debugConsole": {
      "autoScroll": true,
      "maxLines": 1000,
      "showError": true,
      "showInfo": true,
      "showWarning": true,
      "title": "Output Log",
      "visible": true
    },
    "hierarchy": {
      "showAssetSource": false,
      "showEntityId": true,
      "title": "World Outliner",
      "visible": true
    },
    "inspector": {
      "showAssetRefs": true,
      "showCamera": true,
      "showMeshRenderer": true,
      "showTransform": true,
      "title": "Details",
      "visible": true
    }
  },
  "version": 1
}