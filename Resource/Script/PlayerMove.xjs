class PlayerMove : ScriptBehaviour
{
    public:
        [[FieldId("1300000001")]]
        float speed = 3.0f; 

        void OnCreate()
        {
            Log.Info("PlayerMove created");
        }   

        void OnUpdate(float dt)
        {
            float horizontal = Input.GetAxis("Horizontal");
            float vertical = Input.GetAxis("Vertical"); 

            Vec3 position = Transform.GetLocalPosition();   

            position.x += horizontal * speed * dt;
            position.z -= vertical * speed * dt;    

            Transform.SetLocalPosition(position);   

            if (Input.WasKeyPressed("Space"))
            {
                Log.Info("Space pressed");
            }
        }   

        void OnDestroy()
        {
            Log.Info("PlayerMove destroyed");
        }
}