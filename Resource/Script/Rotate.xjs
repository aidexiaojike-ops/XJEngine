class Rotate : ScriptBehaviour
{
    public:
        [[FieldId("1000000001")]]
        float speed = 45.0f;
    
        [[FieldId("1000000002")]]
        bool enabled = true;
    
        void OnUpdate(float dt)
        {
            if (!enabled)
                return;

            Vec3 angles =
                Transform.GetLocalEulerAngles();

            angles.y += speed * dt;

            Transform.SetLocalEulerAngles(angles);
        }
};
